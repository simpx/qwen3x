[Unit]
Description=Qwen3.5 session runtime
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/qwen3x
EnvironmentFile=-/etc/qwen35-runtime.env
ExecStart=/opt/qwen3x/build/qwen35 --model /opt/qwen3x/build/qwen35-0.8b.bin --render /opt/qwen3x/build/qwen35-render.bin --host 127.0.0.1 --port 8000 --slots 2
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
