[Unit]
Description=qwen3x personal OpenAI-compatible runtime
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/qwen3x/04-runtime
EnvironmentFile=/etc/qwen3x-runtime.env
ExecStart=/opt/qwen3x/.venv/bin/python runtime.py --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
